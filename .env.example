# ============================================================
# Primezora Technologies — Environment Configuration
# ============================================================

# Application/runtime PostgreSQL connection (use the transaction pooler on Vercel).
DATABASE_URL=""

# Direct PostgreSQL connection for Prisma CLI and explicit production seed operations.
DIRECT_DATABASE_URL=""

# Optional Prisma migration connection override. If unset, Supabase transaction
# pooler URLs in DATABASE_URL are automatically changed to session mode (port
# 5432). Set this explicitly if your deployment uses a different pooler endpoint.
MIGRATION_DATABASE_URL=""

# Legacy compatibility alias; not a replacement for Production DIRECT_DATABASE_URL.
DIRECT_URL=""

# TEST-only values belong in .env.test.local.
# Current TEST runtime prefers DIRECT_DATABASE_URL_TEST; DATABASE_URL_TEST is its fallback.
# Prisma CLI TEST operations use DIRECT_DATABASE_URL_TEST.

# ============================================================
# Admin Authentication
# ============================================================
# Production credentials are deployment-only. For local development, run
# `npm run admin:setup:test` to configure separate credentials in .env.test.local.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ============================================================
# Supabase Configuration & Customer Authentication
# ============================================================
# Project URL (public):
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase Anon Key (public):
# Required for customer login.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Service Role Key (SERVER-ONLY — Never prefix with NEXT_PUBLIC_):
# Required for customer registration, authenticated admin operations, and storage.
SUPABASE_SERVICE_ROLE_KEY=""

# Public Supabase Storage bucket for uploaded images (default: product-images).
# The server creates it on first upload if it is missing.
SUPABASE_STORAGE_BUCKET="product-images"

# Customer Session Secret (optional — falls back to ADMIN_SESSION_SECRET if not set)
CUSTOMER_SESSION_SECRET=""

# Google and Facebook OAuth credentials are configured in Supabase Auth
# Providers; do not add provider secrets to this application environment.
# Add the app callback URL to Supabase Auth's allowed redirect URLs:
#   http://localhost:3000/api/auth/customer/oauth/callback*
#   https://<your-production-origin>/api/auth/customer/oauth/callback*

# Legacy customer email verification / transactional mail
# New customer registrations do not require email confirmation.
# Use the canonical HTTPS origin in production; localhost for local development.
PUBLIC_SITE_URL="http://localhost:3000"
# Must use a sender address on a domain verified with Resend.
EMAIL_FROM="Primezora <noreply@primezora.com>"
# Server-only Resend API key. Verification sends fail closed when absent.
RESEND_API_KEY=""

# ============================================================
# Checkout Payments
# ============================================================
# Manual bank transfers are verified by an administrator. Configure the exact
# business account details shown to customers after they place an order.
BANK_TRANSFER_BANK_NAME=""
BANK_TRANSFER_ACCOUNT_NAME=""
BANK_TRANSFER_ACCOUNT_NUMBER=""
BANK_TRANSFER_BRANCH=""
# International-format digits including country code; no wa.me URL or token.
WHATSAPP_BUSINESS_NUMBER=""
# Private Supabase Storage bucket dedicated to payment receipts.
SUPABASE_PAYMENT_RECEIPTS_BUCKET="payment-receipts"

# PayHere hosted card checkout. Start with sandbox and switch to live only after
# merchant onboarding and production credentials are configured.
PAYHERE_MODE="sandbox"
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""

# ============================================================
# Shared Application Rate Limiting (Upstash Redis)
# ============================================================
# Required for protected production API routes; requests fail closed when unavailable.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
