# ============================================================
# Primezora Technologies — Environment Configuration
# ============================================================

# Database Connection (Supabase PostgreSQL via transaction pooler)
DATABASE_URL=""

# Direct Database Connection (for migrations)
DIRECT_URL=""

# ============================================================
# Admin Authentication
# ============================================================
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ============================================================
# Supabase Configuration & Customer Authentication
# ============================================================
# Project URL (public):
NEXT_PUBLIC_SUPABASE_URL=""

# Supabase Anon Key (public):
# Required for customer authentication (signup, login, session tokens).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase Service Role Key (SERVER-ONLY — Never prefix with NEXT_PUBLIC_):
# Used server-side for authenticated admin operations / storage.
SUPABASE_SERVICE_ROLE_KEY=""

# Supabase Storage Bucket for product images (default: product-images)
SUPABASE_STORAGE_BUCKET="product-images"

# Customer Session Secret (optional — falls back to ADMIN_SESSION_SECRET if not set)
CUSTOMER_SESSION_SECRET=""

# ============================================================
# Shared Application Rate Limiting (Upstash Redis)
# ============================================================
# Required for protected production API routes; requests fail closed when unavailable.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
